# 服务器部署环境变量模板。
# 使用前复制为 deploy/server.env，并替换所有 change_me / replace_with_* 值。
# 注意：deploy/server.env 会包含真实密码和 API Key，不要提交到 Git。

# ==================== 基础服务 ====================
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_DATABASE=learning_assistant
REDIS_PASSWORD=change_me_redis_password
WEB_PORT=80

# ==================== Spring Boot ====================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
TZ=Asia/Shanghai

# Docker 网络内访问 MySQL，主机名固定为 compose service 名称 mysql。
MYSQL_URL=jdbc:mysql://mysql:3306/learning_assistant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me_mysql_root_password

# JWT 签名密钥必须足够长，建议使用 32 位以上随机字符串。
APP_AUTH_SECRET=replace_with_32_chars_or_longer_random_secret
APP_STORAGE_DIR=/data/learning-assistant-files
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 首次部署可以打开管理员初始化；创建成功后建议改为 false 并重启。
APP_ADMIN_BOOTSTRAP_ENABLED=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_admin_password
APP_ADMIN_NICKNAME=管理员

# ==================== Redis ====================
APP_REDIS_ENABLED=true
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=change_me_redis_password

# ==================== LLM ====================
LLM_ENABLED=true
LLM_BASE_URL=https://your-llm-endpoint.example.com
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL=replace_with_model_name
LLM_API_FORMAT=responses
LLM_TIMEOUT=90s

# ==================== Embedding ====================
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=https://api.voyageai.com
EMBEDDING_API_KEY=replace_with_embedding_api_key
EMBEDDING_MODEL=voyage-multimodal-3
EMBEDDING_TIMEOUT=30s
EMBEDDING_TOP_K=8
EMBEDDING_SCORE_THRESHOLD=0.35

# ==================== Qdrant ====================
# Compose 部署时后端通过 Docker 网络访问 qdrant，不要写 127.0.0.1。
VECTOR_STORE_ENABLED=true
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_BASE_URL=http://qdrant:6333
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=learning_assistant_chunks_voyage_multimodal_3
VECTOR_STORE_TIMEOUT=10s

# ==================== 检索质量/速度开关 ====================
# 如果回答慢，先把 HyDE 关闭；它会额外调用一次模型生成“假设答案”，速度成本较高。
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_QUERIES=3
QUERY_EXPANSION_LOCAL_FALLBACK=true
QUERY_EXPANSION_HYDE_ENABLED=false
RERANKER_ENABLED=true
RERANKER_PROVIDER=local

# ==================== 文档解析能力 ====================
OCR_ENABLED=true
OCR_LANG=eng+chi_sim
DOCUMENT_PREVIEW_CONVERTER_ENABLED=true
PDF_COMPRESSION_ENABLED=true

# 大 PDF 优先可交付：先完成导入和预览，再让后台慢慢补 OCR / 向量索引。
APP_PDF_LARGE_FAST_IMPORT_BYTES=134217728
APP_PDF_LARGE_FAST_IMPORT_MAX_TEXT_PAGES=80
APP_OCR_INLINE_PDF_MAX_BYTES=524288000
APP_OCR_INLINE_PDF_MAX_PAGES=1000
