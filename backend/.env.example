# Copy this file to .env.local on each machine and fill in real secrets.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MySQL
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/learning_assistant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me
JPA_DDL_AUTO=update
APP_STORAGE_DIR=./data/learning-assistant-files
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# LLM provider
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=replace_with_your_key
LLM_MODEL=
LLM_TIMEOUT=60s

# Embedding provider
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=replace_with_embedding_key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_TIMEOUT=30s
EMBEDDING_TOP_K=5
EMBEDDING_SCORE_THRESHOLD=0.55

# OCR
OCR_ENABLED=false
OCR_LANG=eng+chi_sim
OCR_COMMAND=tesseract
OCR_COMMAND_TEMPLATE=
OCR_TIMEOUT=20s

# Document preview
DOCUMENT_PREVIEW_RENDER_DPI=144
DOCUMENT_PREVIEW_CONVERTER_ENABLED=true
DOCUMENT_PREVIEW_CONVERTER_COMMAND=soffice
DOCUMENT_PREVIEW_CONVERTER_TIMEOUT=60s
