# Copy this file to .env.local on each machine and fill in real secrets.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MySQL
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/learning_assistant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
APP_STORAGE_DIR=./data/learning-assistant-files
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
APP_AUTH_SECRET=replace_with_a_long_random_secret

# Email verification login (QQ: smtp.qq.com / 465, 163: smtp.163.com / 465)
EMAIL_CODE_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=yourname@qq.com
SMTP_PASSWORD=replace_with_smtp_authorization_code
SMTP_SSL_ENABLE=true
EMAIL_CODE_FROM=yourname@qq.com
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_EMAIL_COOLDOWN_SECONDS=60
EMAIL_CODE_IP_HOURLY_LIMIT=10
EMAIL_CODE_DEFAULT_PROVIDER=qq

# Optional second sender account selectable in the login page.
EMAIL_CODE_QQ_HOST=smtp.qq.com
EMAIL_CODE_QQ_PORT=465
EMAIL_CODE_QQ_USERNAME=yourname@qq.com
EMAIL_CODE_QQ_PASSWORD=replace_with_qq_smtp_authorization_code
EMAIL_CODE_QQ_FROM=yourname@qq.com
EMAIL_CODE_NETEASE_HOST=smtp.163.com
EMAIL_CODE_NETEASE_PORT=465
EMAIL_CODE_NETEASE_USERNAME=yourname@163.com
EMAIL_CODE_NETEASE_PASSWORD=replace_with_163_smtp_authorization_code
EMAIL_CODE_NETEASE_FROM=yourname@163.com

# LLM provider
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60s

# Embedding provider
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=replace_with_embedding_key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_TIMEOUT=30s
EMBEDDING_TOP_K=5
EMBEDDING_SCORE_THRESHOLD=0.55

# Optional Qdrant vector store. Start local Qdrant with:
#   docker compose -f docker-compose.qdrant.yml up -d
VECTOR_STORE_ENABLED=false
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_BASE_URL=http://127.0.0.1:6333
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=learning_assistant_chunks
VECTOR_STORE_TIMEOUT=10s

# Query expansion and HyDE retrieval.
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_QUERIES=4
QUERY_EXPANSION_LOCAL_FALLBACK=true
QUERY_EXPANSION_HYDE_ENABLED=true
QUERY_EXPANSION_HYDE_WEIGHT=0.72

# Saved RAG evaluation suites can opt into scheduled regression runs.
RAG_EVALUATION_SCHEDULER_ENABLED=true
RAG_EVALUATION_SCHEDULER_SCAN_INTERVAL=30m

# Optional reranker. Keep provider=local for the built-in heuristic reranker.
# For OpenAI/Cohere/Jina-compatible rerank APIs, set provider=api and base URL.
RERANKER_ENABLED=true
RERANKER_PROVIDER=local
RERANKER_BASE_URL=
RERANKER_API_KEY=replace_with_reranker_key
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_TIMEOUT=10s
RERANKER_CANDIDATES=30
RERANKER_RETRIEVAL_WEIGHT=0.55
RERANKER_LEXICAL_WEIGHT=0.45

# OCR
OCR_ENABLED=false
OCR_LANG=eng+chi_sim
OCR_COMMAND=tesseract
OCR_COMMAND_TEMPLATE=
OCR_TIMEOUT=20s

# Document preview
DOCUMENT_PREVIEW_RENDER_DPI=144
DOCUMENT_PREVIEW_CONVERTER_ENABLED=true
DOCUMENT_PREVIEW_CONVERTER_COMMAND=soffice
DOCUMENT_PREVIEW_CONVERTER_TIMEOUT=60s

# Large PDF compression
PDF_COMPRESSION_ENABLED=true
PDF_COMPRESSION_COMMAND=gs
PDF_COMPRESSION_COMMAND_TEMPLATE=
PDF_COMPRESSION_TIMEOUT=180s
PDF_COMPRESSION_MIN_BYTES=67108864
PDF_COMPRESSION_TARGET_DPI=144
