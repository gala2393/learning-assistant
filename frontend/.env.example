VITE_API_BASE=http://localhost:8080/api

# 网站 ICP 备案号。请只填写真实已通过备案的编号；留空则不展示备案栏。
VITE_ICP_BEIAN_TEXT=闽ICP备2026021921号
VITE_ICP_BEIAN_URL=https://beian.miit.gov.cn/

# 公安联网备案号。按备案平台要求：图标在前，备案号在后。
VITE_PUBLIC_SECURITY_BEIAN_TEXT=闽公网安备35052402061802号
VITE_PUBLIC_SECURITY_BEIAN_URL=https://beian.mps.gov.cn/#/query/webSearch?code=35052402061802
VITE_PUBLIC_SECURITY_BEIAN_ICON=/beian-police.png

# Optional on Vercel. If VITE_API_BASE is left unset at build time, the app
# falls back to same-origin /api and the Vercel API proxy reads this value.
BACKEND_API_BASE=https://your-railway-backend.up.railway.app/api
